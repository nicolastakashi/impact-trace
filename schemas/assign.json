{
  "type": "object",
  "required": ["week", "assignments"],
  "properties": {
    "week": { "type": "string", "pattern": "^\\d{4}-W\\d{2}$" },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "project_id", "why"],
        "properties": {
          "key": { "type": "string" },
          "project_id": { "type": ["string", "null"] },
          "why": { "type": "string" }
        }
      }
    }
  }
}
