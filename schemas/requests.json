{
  "type": "object",
  "required": ["from", "prs"],
  "additionalProperties": false,
  "properties": {
    "from": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "prs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repo", "number", "author", "requests"],
        "additionalProperties": false,
        "properties": {
          "repo": { "type": "string" },
          "number": { "type": "integer" },
          "author": { "type": "string" },
          "requests": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["at", "reviewer", "requester"],
              "additionalProperties": false,
              "properties": {
                "at": { "type": "string" },
                "reviewer": { "type": "string" },
                "requester": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    }
  }
}
