{
  "type": "object",
  "required": [
    "week",
    "pages_read",
    "issues",
    "attachments",
    "projects"
  ],
  "properties": {
    "week": {
      "type": "string",
      "pattern": "^\\d{4}-W\\d{2}$"
    },
    "pages_read": {
      "type": "integer",
      "minimum": 1
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "url",
          "status_type",
          "completed_at",
          "project_name",
          "milestone_name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]+-\\d+$"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "status_type": {
            "enum": [
              "completed",
              "started",
              "unstarted",
              "backlog",
              "triage",
              "canceled",
              "duplicate"
            ]
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "project_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "milestone_name": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "urls"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]+-\\d+$"
          },
          "urls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "url",
          "status",
          "lead",
          "milestones"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "lead": {
            "type": [
              "string",
              "null"
            ]
          },
          "milestones": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "progress",
                "target_date"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "progress": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "target_date": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
