{
  "type": "object",
  "required": ["week", "mentions"],
  "properties": {
    "week": { "type": "string", "pattern": "^\\d{4}-W\\d{2}$" },
    "mentions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "about", "quote"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["praise", "ask", "info", "automated"] },
          "about": { "type": "string" },
          "quote": { "type": ["string", "null"] }
        }
      }
    }
  }
}
