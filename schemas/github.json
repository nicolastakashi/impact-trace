{
  "type": "object",
  "required": [
    "week",
    "prs_merged",
    "prs_open",
    "reviews_given",
    "review_comments_received"
  ],
  "properties": {
    "week": {
      "type": "string",
      "pattern": "^\\d{4}-W\\d{2}$"
    },
    "prs_merged": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "repo",
          "number",
          "title",
          "url",
          "at",
          "linear_refs"
        ],
        "properties": {
          "repo": {
            "type": "string"
          },
          "number": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "at": {
            "type": "string"
          },
          "linear_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]+-\\d+$"
            }
          }
        }
      }
    },
    "prs_open": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "repo",
          "number",
          "title",
          "url",
          "at",
          "linear_refs"
        ],
        "properties": {
          "repo": {
            "type": "string"
          },
          "number": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "at": {
            "type": "string"
          },
          "linear_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]+-\\d+$"
            }
          }
        }
      }
    },
    "reviews_given": {
      "type": "integer",
      "minimum": 0
    },
    "review_comments_received": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "repo",
          "number",
          "author",
          "body",
          "url"
        ],
        "properties": {
          "repo": {
            "type": "string"
          },
          "number": {
            "type": "integer"
          },
          "author": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    }
  }
}
