{
  "type": "object",
  "required": ["from", "prs_read", "reviews"],
  "additionalProperties": false,
  "properties": {
    "from": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "prs_read": { "type": "integer", "minimum": 0 },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repo", "number", "author", "state", "submitted_at"],
        "additionalProperties": false,
        "properties": {
          "repo": { "type": "string" },
          "number": { "type": "integer" },
          "author": { "type": "string" },
          "state": { "type": "string" },
          "submitted_at": { "type": ["string", "null"] }
        }
      }
    }
  }
}
